  textoBoton2: {fileID: 649342887}
  textoBoton3: {fileID: 881719972}
  textoYo: "Hola, oye note que te conectaste a jugar m\xE1s temprano."
  textoNPC: Si, hoy no tuve clases y suelo jugar luego de la escuela.
  textoChoice1: "\xBFA qu\xE9 hora sueles jugar?"
  tipoChoice1: 2
  respuestaNPCChoice1: A la hora que normalmente me conecto xd
  textoChoice2: Que bien que tengas tiempo
  tipoChoice2: 1
  respuestaNPCChoice2: Si xd
  textoChoice3: "Yo tambi\xE9n juego por estas horas"
  tipoChoice3: 0
  respuestaNPCChoice3: Por eso siempre jugamos xd auqnue si te he visto desde antes
  recolectorPrevio: {fileID: 0}
  hacerZoomOut: 0
  camara: {fileID: 0}
  fovInicial: 60
  fovFinal: 90
  duracionZoom: 2
  esperaZoom: 1.5
