  prefabBurbujaNPC: {fileID: 7550904496664526930, guid: 2bc007b16b8e3f949ae965ea4d34af3d, type: 3}
  prefabBurbujaJugador: {fileID: 7550904496664526930, guid: 15143605e2bc51442bb349166ec1bb29, type: 3}
  boton1: {fileID: 186607545}
  boton2: {fileID: 2136245737}
  boton3: {fileID: 1801841466}
  textoBoton1: {fileID: 1340565850}
  textoBoton2: {fileID: 1851945454}
  textoBoton3: {fileID: 574773287}
  mensajeInicial11: No le digo a otros que hablo contigo
  textoChoice11_1: No pasa nada
  tipoChoice11_1: 0
  respNPC11_1: "S\xED... igual me alegra poder hablar contigo"
  textoChoice11_2: Es mejor que sea entre nosotros
  tipoChoice11_2: 2
  respNPC11_2: "S\xED, exacto. T\xFA me entiendes"
  textoChoice11_3: "S\xED, es nuestro secreto"
  tipoChoice11_3: 2
  respNPC11_3: "Me alegra mucho... eres especial para m\xED"
  mensajeInicial12: "Ser\xEDa chevere jugar en persona alg\xFAn d\xEDa"
  textoChoice12_1: "Tal vez en grupo con m\xE1s gente"
  tipoChoice12_1: 2
  respNPC12_1: "Mmmm no lo s\xE9"
  textoChoice12_2: "S\xED, podr\xEDamos vernos"
  tipoChoice12_2: 0
  respNPC12_2: Donde vives?
  textoChoice12_3: "Hay parque cerca, podr\xEDamos ir"
  tipoChoice12_3: 2
  respNPC12_3: Dejame ver
  pausaEntreMomentos: 2
  sonidoNPC: {fileID: 878580067}
